        }

        .button {
            display: inline-block;
            background: #111827;
            color: white;
            padding: 14px 25px;
            margin-top: 15px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            cursor: pointer;
        }

        .button:hover {
            background: #000000;
        }

        .main-button {
            background: #16a34a;
            font-size: 18px;
            padding: 16px 30px;
        }

        .main-button:hover {
            background: #15803d;
        }

        .center {
            text-align: center;
        }

        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 25px 15px;
            margin-top: 40px;
        }

        @media (max-width: 600px) {
            header h1 {
                font-size: 30px;
            }

            header p {
                font-size: 16px;
            }

            .card {
                padding: 22px;
            }
        }
    </style>
</head>

